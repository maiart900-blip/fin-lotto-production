{
  "buildCommand": "node .v0/inject-built-with-v0.mjs && next build",
  "crons": [
    {
      "path": "/api/cron/daily-closing",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/daily-owner-report",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/daily-risk-reset",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "0 20 * * 0"
    },
    {
      "path": "/api/cron/auto-recovery",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reconciliation",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
