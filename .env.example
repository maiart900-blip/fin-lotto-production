# =====================================================
# FIN LOTTO R+ - Environment Variables
# =====================================================
# คัดลอกไฟล์นี้เป็น .env.local สำหรับ development
# หรือตั้งค่าใน Vercel Dashboard สำหรับ production
# =====================================================

# ----- Database (Supabase) -----
# ได้จาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Application URLs -----
# URL ของเว็บไซต์ (ไม่มี / ต่อท้าย)
NEXT_PUBLIC_APP_URL=https://finlotto.com
NEXTAUTH_URL=https://finlotto.com

# ----- Authentication -----
# สร้าง secret ด้วย: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key
JWT_SECRET=your-jwt-secret-key

# ----- Optional: External Services -----
# สำหรับ payment gateway, SMS, etc.
# PAYMENT_API_KEY=
# SMS_API_KEY=

# ----- Optional: Analytics -----
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# =====================================================
# สำหรับ Production บน Vercel:
# 1. ไปที่ Project Settings > Environment Variables
# 2. เพิ่มตัวแปรทั้งหมดข้างบน
# 3. เลือก Production environment
# 4. Redeploy
# =====================================================
